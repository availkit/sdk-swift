{
  "version": "0.1.1",
  "scope": "public-booking-only",
  "runtime": {
    "swift": "6.4.x",
    "ios": 15,
    "macos": "12"
  },
  "operations": {
    "getPublicPage": {
      "method": "GET",
      "path": "/v1/public/pages/{pageId}",
      "input": null,
      "status": 200,
      "output": {
        "$ref": "#/components/schemas/PublicPage"
      }
    },
    "listPublicOfferings": {
      "method": "GET",
      "path": "/v1/public/pages/{pageId}/offerings",
      "input": null,
      "status": 200,
      "output": {
        "$ref": "#/components/schemas/PublicOfferingPage"
      }
    },
    "publicAvailability": {
      "method": "GET",
      "path": "/v1/public/pages/{pageId}/availability",
      "input": null,
      "status": 200,
      "output": {
        "$ref": "#/components/schemas/Availability"
      }
    },
    "bookPublic": {
      "method": "POST",
      "path": "/v1/public/pages/{pageId}/bookings",
      "input": {
        "$ref": "#/components/schemas/PublicBookingInput"
      },
      "status": 201,
      "output": {
        "$ref": "#/components/schemas/PublicBooking"
      }
    },
    "getPublicBooking": {
      "method": "GET",
      "path": "/v1/public/pages/{pageId}/bookings/{bookingId}",
      "input": null,
      "status": 200,
      "output": {
        "$ref": "#/components/schemas/PublicBooking"
      }
    },
    "cancelPublicBooking": {
      "method": "POST",
      "path": "/v1/public/pages/{pageId}/bookings/{bookingId}/cancel",
      "input": {
        "$ref": "#/components/schemas/Empty"
      },
      "status": 200,
      "output": {
        "$ref": "#/components/schemas/PublicBooking"
      }
    },
    "reschedulePublicBooking": {
      "method": "POST",
      "path": "/v1/public/pages/{pageId}/bookings/{bookingId}/reschedule",
      "input": {
        "$ref": "#/components/schemas/RescheduleInput"
      },
      "status": 200,
      "output": {
        "$ref": "#/components/schemas/PublicBooking"
      }
    }
  },
  "openapi_sha256": "6e126d6856c9d07f7af49137c453f7fba0d715fb4e957937fe47cb4bc8d55aa5",
  "supported_projection_sha256": "0aaf52c00207b54f6c9ab29b941c6a47f8383ef84ab10805abb2bc87808534ca",
  "unsupported_optional": {
    "recovery_v2_profile": {
      "method": "GET",
      "path": "/v2/human/recovery/profile",
      "reason": "separate same-origin browser recovery"
    },
    "recovery_v2_start": {
      "method": "POST",
      "path": "/v2/human/recovery/start",
      "reason": "separate same-origin browser recovery"
    },
    "recovery_v2_finish": {
      "method": "POST",
      "path": "/v2/human/recovery/finish",
      "reason": "separate same-origin browser recovery"
    },
    "getBusinessExportPage": {
      "method": "GET",
      "path": "/v1/workspaces/{workspaceId}/export",
      "reason": "unsupported optional business export"
    }
  }
}
